# Copy this file to .env and change the values.
# Avoid special characters in passwords, they end up inside connection URLs.

POSTGRES_DB=bookly
POSTGRES_USER=bookly
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

RABBITMQ_USER=bookly
RABBITMQ_PASSWORD=change_me

# At least 32 characters.
JWT_SECRET=change_me_to_a_long_random_string_of_32_chars
